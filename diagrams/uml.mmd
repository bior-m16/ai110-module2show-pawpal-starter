classDiagram
    class Owner {
        +str name
        +int available_minutes
        +list~Pet~ pets
        +add_pet(pet) None
        +remove_pet(pet) None
        +get_all_tasks() list~Task~
        +filter_tasks(pet_name, completed) list~Task~
    }

    class Pet {
        +str name
        +str species
        +int age
        +str notes
        +list~Task~ tasks
        +add_task(task) None
        +remove_task(task) None
        +get_pending_tasks() list~Task~
        +complete_task(task, now) None
    }

    class Task {
        +str title
        +str pet_name
        +int duration_minutes
        +int priority
        +datetime scheduled_time
        +str frequency
        +bool completed
        +mark_complete(now) Optional~Task~
    }

    class Scheduler {
        +Owner owner
        +sort_by_time(tasks) list~Task~
        +generate_plan(day) list~Task~
        +detect_conflicts(tasks) list~tuple~
        +conflicts_for(task) list~Task~
        +explain_plan(plan) str
    }

    Owner "1" *-- "*" Pet : has
    Pet "1" *-- "*" Task : has
    Scheduler --> Owner : plans for
